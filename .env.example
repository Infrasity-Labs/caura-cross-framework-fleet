# Where Caura runs. These defaults match scripts/start-caura.sh.
CAURA_URL=http://localhost:8000
CAURA_API_KEY=standalone

# The model the agents think with. Any OpenAI-compatible endpoint works.
# OpenRouter (default):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-your-key-here
LLM_MODEL=openai/gpt-5.4-mini
# Cap on tokens per reply. Keeps OpenRouter from refusing calls when credit is low.
LLM_MAX_TOKENS=4096
# A local Ollama server instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# The fleet the team shares. Change it to start from an empty memory.
FLEET_ID=launch-team
